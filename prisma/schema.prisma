// Cadence - personal finance schema.
// Money is Decimal(14,2); dates that represent a calendar day are @db.Date.
// Phase 2A: EmailConnection stores OAuth-connected Gmail/Outlook accounts, and
// StagedTransaction is now written to by the email ingestion pipeline.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Currencies are plain strings (ISO 4217) rather than an enum so a new one is a
/// one-line change in src/lib/currency.ts instead of a migration.

enum AccountType {
  CHECKING
  SAVINGS
  CASH
  OTHER
}

enum AccountStatus {
  ACTIVE
  ARCHIVED
}

enum CategoryKind {
  EXPENSE
  INCOME
}

enum TransactionType {
  EXPENSE
  INCOME
  TRANSFER
  OPENING_BALANCE
  EXTERNAL_TRANSFER
}

enum TransactionSource {
  MANUAL
  CSV
  GMAIL
  OUTLOOK
  PAYPAL
  PAYDAY_CHECKIN
  OPENING_BALANCE
  /// Posted automatically from a RecurringItem on its due date - see
  /// postDueRecurringItems() in src/lib/recurring-posting.ts.
  RECURRING
}

/// Which leg of a transfer a row is (OUT on the source leg, IN on the
/// destination leg), or, for an EXTERNAL_TRANSFER row (no paired leg), simply
/// whether money left (OUT) or arrived (IN). Null for every other type.
enum TransferDirection {
  OUT
  IN
}

enum StagedStatus {
  PENDING
  APPROVED
  REJECTED
}

enum EmailProvider {
  GMAIL
  OUTLOOK
}

enum PayPeriod {
  A
  B
}

enum RecurringFrequency {
  WEEKLY
  BIWEEKLY
  /// Twice a month, on two independent days (RecurringItem.anchorDay and
  /// .secondAnchorDay), each weekend-shifted the way a payday is - see
  /// advanceDate() in src/lib/recurring.ts.
  SEMI_MONTHLY
  MONTHLY
  YEARLY
}

enum RecurringKind {
  SUBSCRIPTION
  CONTRIBUTION
}

/// Singleton row: the PIN gate and app-wide preferences.
model Settings {
  id                         String    @id @default("singleton")
  pinHash                    String?
  displayCurrency            String    @default("USD")
  language                   String    @default("en")
  /// Payday planner: default protected buffer = max(bufferPercent% of income, bufferFloorAmount).
  bufferPercent              Int       @default(10)
  bufferFloorAmount          Decimal   @default(2000) @db.Decimal(14, 2)
  bufferFloorCurrency        String    @default("DOP")
  carryoverIncludedByDefault Boolean   @default(true)
  /// The civil date (APP_TIMEZONE) the user last dismissed the auto-opened
  /// payday check-in prompt, so it doesn't force-open again the same day.
  checkinPromptDismissedOn   DateTime? @db.Date
  /// "Count history from" (first named "count income history from"): every
  /// average reads only the pay periods that start on or after this civil date
  /// - Afford's income projection, the category suggestions, the Reports
  /// average per period - and the monthly windows only months that start on or
  /// after that first period (K9, src/lib/history-window.ts). For when the
  /// user's situation changed and older periods would only distort the
  /// averages. Global, one date for every account. Null is no boundary.
  incomeHistoryStartDate     DateTime? @db.Date
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt
}

model Account {
  id                            String                         @id @default(cuid())
  name                          String
  currency                      String
  type                          AccountType                    @default(CHECKING)
  status                        AccountStatus                  @default(ACTIVE)
  archivedAt                    DateTime?
  createdAt                     DateTime                       @default(now())
  transactions                  Transaction[]
  stagedTransactions            StagedTransaction[]
  paydaySnapshots               PaydayAccountSnapshot[]
  paydayAllocations             PaydayPlanAllocation[]
  recurringItems                RecurringItem[]
  goalContributions             GoalContribution[]
  recurringSuggestionDismissals RecurringSuggestionDismissal[]

  @@index([name])
  @@index([status, name])
}

model Category {
  id                    String                 @id @default(cuid())
  name                  String                 @unique
  kind                  CategoryKind           @default(EXPENSE)
  isSubscriptionDefault Boolean                @default(false)
  /// Marks the category whose expense transactions count as savings/investing
  /// rather than lifestyle spending in the monthly pace feature (src/lib/data/monthly.ts).
  isSavingsDefault      Boolean                @default(false)
  /// User-configured: this category is essential fixed spending, so the payday
  /// planner reserves it before flexible category suggestions instead of
  /// treating it as discretionary. Never inferred from the category's name.
  isEssentialFixed      Boolean                @default(false)
  color                 String                 @default("#7a8590")
  icon                  String?
  createdAt             DateTime               @default(now())
  transactions          Transaction[]
  budgets               Budget[]
  recurringItems        RecurringItem[]
  stagedTransactions    StagedTransaction[]
  paydayAllocations     PaydayPlanAllocation[]

  @@index([kind])
}

model Transaction {
  id                      String             @id @default(cuid())
  date                    DateTime           @db.Date
  amount                  Decimal            @db.Decimal(14, 2)
  currency                String
  type                    TransactionType
  accountId               String
  categoryId              String?
  note                    String?
  source                  TransactionSource  @default(MANUAL)
  /// Identifier from the originating system (Phase 2 dedup). Null for manual/csv.
  externalId              String?
  /// Both legs of a transfer share this id.
  transferId              String?
  /// OUT on the source leg, IN on the destination leg, null otherwise.
  transferDirection       TransferDirection?
  /// A one-off the user confirmed as such (see src/lib/extraordinary.ts):
  /// left out of the averages that estimate typical spending - the payday
  /// planner's category suggestions and Reports' monthly pace - while still
  /// counting as real spending everywhere else. Only ever set by the user.
  isExtraordinary         Boolean            @default(false)
  /// INCOME only: a one-off receipt (a gift, a sale, a refund) the user marked
  /// as such. It counts as the period's real income everywhere it is a fact -
  /// the period summary, Reports, the ledger, account balances - and is left
  /// out only of Afford's income history, the figure that estimates what the
  /// user will earn in future periods. Kept apart from isExtraordinary, which
  /// is spending only. Only ever set by the user.
  isOneOffIncome          Boolean            @default(false)
  /// EXPENSE only: the part of `amount` that was the user's own cost, when the
  /// purchase covered other people who will pay their part back (see
  /// src/lib/shared-expense.ts). Null - every ordinary row - means the whole
  /// amount is the user's. `amount` stays what actually left the account, so
  /// balances and the ledger are untouched; budget spending, Reports'
  /// spending, the averages that estimate typical spending and the one-off
  /// threshold read this figure in its place (src/lib/budget-spending.ts).
  /// Positive and never above `amount`.
  yourShare               Decimal?           @db.Decimal(14, 2)
  /// INCOME only: the shared expense this deposit pays back. A linked deposit
  /// still raises the account's balance like any income, but is left out of
  /// every income estimate (src/lib/period-income.ts) - it is money coming
  /// back, not earnings. One shared expense may be reimbursed by many deposits over
  /// time. Set to null if the expense is deleted underneath it.
  reimbursesTransactionId String?
  /// The money as it was entered, when that was in another currency than the
  /// account's (QUANTITIES_MAP.md K7): `amount` and `currency` are then what
  /// the account moved, converted once at entry at `rate` (units of the
  /// account's currency per unit of `originalCurrency`) and never again.
  /// All three are null on a row entered in the account's own currency. A row
  /// written before this existed may still carry another currency in
  /// `currency` with these null; every reader converts such a row at today's
  /// rate, as before, until scripts/backfill-account-currency.ts stores it.
  originalAmount          Decimal?           @db.Decimal(14, 2)
  originalCurrency        String?
  rate                    Decimal?           @db.Decimal(20, 10)
  createdAt               DateTime           @default(now())

  account             Account              @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category            Category?            @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  reimburses          Transaction?         @relation("Reimbursement", fields: [reimbursesTransactionId], references: [id], onDelete: SetNull)
  reimbursements      Transaction[]        @relation("Reimbursement")
  /// Set when this charge stands for one occurrence of a recurring item that
  /// posting therefore did not write (see RecurringSettlement).
  recurringSettlement RecurringSettlement?
  /// INCOME or incoming EXTERNAL_TRANSFER only: the parts of this deposit the
  /// user set aside for upcoming recurring occurrences (see RecurringEarmark).
  earmarks            RecurringEarmark[]

  @@unique([source, externalId])
  @@index([date])
  @@index([accountId, date])
  @@index([categoryId])
  @@index([transferId])
  @@index([type, date])
  @@index([reimbursesTransactionId])
}

/// Written by the Phase 2A email ingestion pipeline; reviewed on /review before
/// becoming a real Transaction.
model StagedTransaction {
  id                  String            @id @default(cuid())
  date                DateTime          @db.Date
  amount              Decimal           @db.Decimal(14, 2)
  currency            String
  rawDescription      String
  suggestedCategoryId String?
  /// The account the item will land in on approval. Nullable because
  /// ingestion cannot know which of the user's accounts an email belongs to -
  /// the reviewer picks it before approving.
  accountId           String?
  source              TransactionSource
  externalId          String?
  status              StagedStatus      @default(PENDING)
  createdAt           DateTime          @default(now())
  /// When the ingestion pipeline parsed and wrote this row (debugging/audit).
  parsedAt            DateTime?
  reviewedAt          DateTime?

  suggestedCategory Category? @relation(fields: [suggestedCategoryId], references: [id], onDelete: SetNull)
  account           Account?  @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@unique([source, externalId])
  @@index([status, date])
}

/// One row per OAuth-connected mailbox (Gmail or Outlook). Single-user app, so
/// no owner reference is needed - this is the full set of connected inboxes.
model EmailConnection {
  id                   String        @id @default(cuid())
  provider             EmailProvider
  emailAddress         String
  /// AES-256-GCM ciphertext (iv + authTag + data, base64), never the raw token.
  accessTokenEnc       String
  refreshTokenEnc      String
  accessTokenExpiresAt DateTime
  lastSyncedAt         DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@unique([provider, emailAddress])
}

/// One row per (year, month, period, category). categoryId null = the overall
/// budget for that period; a partial unique index in the migration keeps that
/// row unique, which a plain composite unique cannot do (NULLs are distinct).
model Budget {
  id         String    @id @default(cuid())
  year       Int
  month      Int
  period     PayPeriod
  categoryId String?
  amount     Decimal   @db.Decimal(14, 2)
  currency   String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  category Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([year, month, period, categoryId])
  @@index([year, month, period])
}

/// Automatic posting (src/lib/recurring-posting.ts) charges each due
/// occurrence as a RECURRING-source EXPENSE from `accountId`; a CONTRIBUTION
/// additionally logs a GoalContribution on `goalId`. Both links are nullable so
/// pre-existing rows survive, but an item missing the link its kind needs is
/// skipped (never advanced) by the posting job until the user sets it.
model RecurringItem {
  id                   String             @id @default(cuid())
  name                 String
  amount               Decimal            @db.Decimal(14, 2)
  currency             String
  frequency            RecurringFrequency
  kind                 RecurringKind
  nextDate             DateTime           @db.Date
  /// The day of the month this item is really due on. advanceDate() clamps to
  /// this rather than to the previous occurrence's day, so a short February can
  /// never drag every later occurrence back with it. Set from the date the user
  /// picks and only ever rewritten by an explicit edit - automatic posting
  /// never touches it. Null only for rows written outside the app, where
  /// posting falls back to the occurrence's own day (the pre-anchor behaviour).
  anchorDay            Int?
  /// SEMI_MONTHLY only: the second of the item's two due days each month.
  /// anchorDay and this are otherwise interchangeable - advanceDate() finds
  /// each anchor's own next weekend-shifted realization and walks to
  /// whichever comes sooner, so neither field is "first" in any ordering
  /// sense. Null for every other frequency.
  secondAnchorDay      Int?
  active               Boolean            @default(true)
  /// How many more occurrences to post before the item switches itself off.
  /// Null means unbounded - every ordinary subscription or contribution, and
  /// every row that existed before this column. A number counts down by one
  /// per occurrence claimed (by postDueRecurringItems, or by a skip or
  /// schedule edit past a recorded payment), and the write that reaches 0
  /// also sets `active` to false in the same statement, so the item drops
  /// out of every "active items" read at once. Written by the Afford
  /// calculator for an installment plan and by the recurring form's
  /// "Payments left" field.
  remainingOccurrences Int?
  /// True only for a plan the Afford calculator recorded ("I bought this" -
  /// confirmAffordPurchase in src/lib/data/afford.ts). The recurring form
  /// never sets it, so an installment plan entered by hand - even one given a
  /// "Payments left" count - stays false. The Recurring page lists these
  /// under "From Afford" instead of Subscriptions, and re-checks each one
  /// still owing payments against current projections.
  fromAfford           Boolean            @default(false)
  categoryId           String?
  /// The account each posted occurrence is charged to. Required for posting.
  accountId            String?
  /// CONTRIBUTION only: the goal each posted occurrence is logged against.
  /// Ignored for SUBSCRIPTION items.
  goalId               String?
  note                 String?
  /// Where the charges that suggested this item came from (MANUAL or CSV),
  /// set when the user accepts a suggestion on the Recurring page (see
  /// src/lib/data/recurring-suggestions.ts). Null for an item entered by hand.
  detectedFrom         TransactionSource?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  category          Category?              @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  account           Account?               @relation(fields: [accountId], references: [id], onDelete: SetNull)
  goal              Goal?                  @relation(fields: [goalId], references: [id], onDelete: SetNull)
  paydayAllocations PaydayPlanAllocation[]
  goalContributions GoalContribution[]
  settlements       RecurringSettlement[]
  earmarks          RecurringEarmark[]

  @@index([active, nextDate])
  @@index([kind])
  @@index([accountId])
  @@index([goalId])
}

/// A recurring-pattern suggestion the user dismissed on the Recurring page:
/// this merchant (the same cleaned key the CSV review groups by, see
/// cleanMerchantKey in src/lib/import-grouping.ts) on this account is never
/// suggested again, however many more matching charges arrive. Accepting a
/// suggestion writes nothing here - the RecurringItem it creates is what
/// stops it being suggested (see src/lib/recurring-detection.ts).
model RecurringSuggestionDismissal {
  id          String   @id @default(cuid())
  accountId   String
  merchantKey String
  dismissedAt DateTime @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, merchantKey])
}

/// One charge Cadence did not write itself (a manual entry, a CSV row, an
/// approved receipt) standing for one occurrence of a recurring item, so
/// posting rolled that occurrence forward instead of writing a second row for
/// the same money. Created by postDueRecurringItems, in the same database
/// transaction as the occurrence's claim, and by recordUpcomingPayment
/// (src/lib/data/posted-duplicates.ts) when the user answers "It's that
/// payment" before the occurrence falls due; a schedule edit re-keys or
/// claims it and a skip of missed occurrences claims it (src/lib/data/
/// recurring.ts). Which charge settles which occurrence is decided by
/// planSettlements (src/lib/recurring-settlement.ts), the matcher the payday
/// check-in reads too.
///
/// Both keys are unique, and that is the rule: a charge settles at most one
/// occurrence of at most one item, for good, and an occurrence is settled at
/// most once. A charge already paired here is never a candidate again.
model RecurringSettlement {
  id              String        @id @default(cuid())
  transactionId   String        @unique
  /// "<itemId>:<YYYY-MM-DD>" - the key the occurrence's RECURRING row would
  /// have carried (recurringExternalId). A CONTRIBUTION occurrence's
  /// GoalContribution carries the same key in recurringExternalId, which is
  /// what makes this charge that contribution's ledger half. A plain string,
  /// so deleting the item cannot erase it.
  occurrenceKey   String        @unique
  /// Null once the item is deleted; occurrenceKey still names it.
  recurringItemId String?
  /// The item's kind when the charge settled it, kept for the same reason.
  kind            RecurringKind
  dueDate         DateTime      @db.Date
  createdAt       DateTime      @default(now())
  /// When the occurrence was claimed: the item rolled past it and it counted
  /// against an installment plan - by postDueRecurringItems, or by a skip or
  /// schedule edit that moved nextDate past it (claimPassedPairings in
  /// src/lib/data/recurring.ts). Null for a pairing the user recorded before
  /// posting reached it ("It's that payment", recordUpcomingPayment) - the
  /// first of those to reach it claims it once, counting its installment,
  /// and sets this; a claimed occurrence that a nextDate moved back walks
  /// again is rolled past without counting.
  claimedByPostingAt DateTime?

  transaction   Transaction    @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  recurringItem RecurringItem? @relation(fields: [recurringItemId], references: [id], onDelete: SetNull)

  @@index([recurringItemId])
}

/// Part of a deposit the user set aside for one occurrence of a recurring
/// item ("This money is for an upcoming payment"): a family member's transfer
/// toward an installment, money moved in from outside Cadence for it. The
/// occurrence then asks that much less of the plan - outstanding = amount -
/// earmarked (outstandingAmount and wholeAmount in
/// src/lib/period-commitments.ts) - whether it is still to come or already
/// posted, and the deposit's earmarked part is left out of the income
/// estimate (src/lib/period-income.ts), so the money is counted once. The
/// posted row keeps the full bank amount; this row stays as the record of
/// what covered it. The same shape as RecurringSettlement (charge <->
/// occurrence), but many-to-many: one deposit may be split over several
/// occurrences and one occurrence may take several deposits, never more than
/// either holds (src/lib/earmarks.ts).
model RecurringEarmark {
  id              String   @id @default(cuid())
  transactionId   String
  /// "<itemId>:<YYYY-MM-DD>" (recurringExternalId) - a plain string, so
  /// deleting the item cannot erase it.
  occurrenceKey   String
  /// Null once the item is deleted; occurrenceKey still names it.
  recurringItemId String?
  dueDate         DateTime @db.Date
  /// In `currency`: the deposit's account's currency when it was written.
  amount          Decimal  @db.Decimal(14, 2)
  currency        String
  createdAt       DateTime @default(now())

  transaction   Transaction    @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  recurringItem RecurringItem? @relation(fields: [recurringItemId], references: [id], onDelete: SetNull)

  @@unique([transactionId, occurrenceKey])
  @@index([occurrenceKey])
  @@index([recurringItemId])
  @@index([dueDate])
}

/// An insight the user dismissed on the Inbox page (src/lib/insights.ts):
/// the same lightweight pattern as RecurringSuggestionDismissal, generalized
/// to every insight source. `source` names the detector and `key` the
/// identity that detector gives each insight (a recurring item's id, a
/// goal's id, an account + merchant pair...), so a dismissed insight never
/// comes back however long its underlying condition persists. `source` is a
/// plain string rather than an enum so a new detector needs no migration;
/// the sources are validated in code (INSIGHT_SOURCES). No foreign keys: a
/// row whose entity is gone is simply never matched again.
model InsightDismissal {
  id          String   @id @default(cuid())
  source      String
  key         String
  dismissedAt DateTime @default(now())

  @@unique([source, key])
}

model Goal {
  id           String    @id @default(cuid())
  name         String
  targetAmount Decimal   @db.Decimal(14, 2)
  currency     String
  targetDate   DateTime? @db.Date
  /// Cached sum of contributions. GoalContribution is the source of truth;
  /// see recomputeGoalSaved() in src/lib/goals.ts.
  savedAmount  Decimal   @default(0) @db.Decimal(14, 2)
  createdAt    DateTime  @default(now())
  achievedAt   DateTime?
  /// Marked by the user on the goal form, never inferred. The Goals page's
  /// debt payoff comparator (src/lib/debt-payoff.ts) reads only these goals.
  isDebt       Boolean   @default(false)

  contributions     GoalContribution[]
  paydayAllocations PaydayPlanAllocation[]
  recurringItems    RecurringItem[]
}

model GoalContribution {
  id                  String   @id @default(cuid())
  goalId              String
  amount              Decimal  @db.Decimal(14, 2)
  currency            String
  date                DateTime @db.Date
  note                String?
  /// Set only when recurring posting created this row automatically (see
  /// src/lib/recurring-posting.ts); null for manually-logged contributions.
  /// Only good for finding the item that is still there - the FK nulls this on
  /// delete, so classification must not depend on it (see recurringExternalId).
  recurringItemId     String?
  /// The externalId of the Transaction this row was posted alongside, i.e.
  /// "<recurringItemId>:<YYYY-MM-DD>". A plain string with no foreign key, so
  /// deleting the RecurringItem cannot erase it the way it erases
  /// recurringItemId. This is what pairs an auto-posted contribution with its
  /// Transaction in the monthly savings/investing calculation, so the pair is
  /// counted once whether or not the item still exists.
  recurringExternalId String?
  /// The account the money left when this contribution was logged by hand,
  /// paired with an EXPENSE Transaction (source MANUAL, externalId
  /// "goal-contribution:<this row's id>") that carries the same money in the
  /// account's own currency - see logManualContribution in src/lib/goals.ts.
  /// Null for rows logged before contributions moved real money (nothing to
  /// backfill: they never had a source account) and for auto-posted rows,
  /// whose account is the RecurringItem's.
  accountId           String?
  createdAt           DateTime @default(now())

  goal          Goal           @relation(fields: [goalId], references: [id], onDelete: Cascade)
  recurringItem RecurringItem? @relation(fields: [recurringItemId], references: [id], onDelete: SetNull)
  account       Account?       @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([goalId, date])
  @@index([recurringItemId])
  @@index([accountId])
  @@index([recurringExternalId])
}

/// Raw USD-based rates, one row per (baseCurrency, targetCurrency, source).
/// rate = units of targetCurrency per 1 baseCurrency. source distinguishes
/// the open.er-api.com table (considered fresh for 24h from fetchedAt) from
/// Banco Popular Dominicano's published rate for DOP/EUR (source "bpd",
/// considered fresh within BPD_RATE_MAX_AGE_DAYS calendar days of asOf - see
/// src/lib/bpd-rates.ts). asOf is null for open.er-api.com rows, which don't
/// publish a rate date distinct from when we fetched them.
model ExchangeRate {
  id             String    @id @default(cuid())
  baseCurrency   String
  targetCurrency String
  rate           Decimal   @db.Decimal(20, 10)
  fetchedAt      DateTime
  source         String    @default("open-er-api")
  asOf           DateTime?

  @@unique([baseCurrency, targetCurrency, source])
}

enum PaydayCheckinStatus {
  DRAFT
  CONFIRMED
}

enum PaydayAllocationType {
  SUBSCRIPTION
  RECURRING_CONTRIBUTION
  GOAL
  ESSENTIAL_CATEGORY
  FLEXIBLE_CATEGORY
  BUFFER
  CARRYOVER
}

/// One row per pay period the user has checked in for. Confirming a check-in
/// creates its income transactions and snapshots; re-confirming an existing
/// CONFIRMED row updates it in place rather than duplicating anything - see
/// confirmPaydayCheckinAction in src/server/actions/payday.ts.
model PaydayCheckin {
  id                String              @id @default(cuid())
  year              Int
  month             Int
  period            PayPeriod
  checkinDate       DateTime            @db.Date
  currency          String
  totalIncome       Decimal             @default(0) @db.Decimal(14, 2)
  includedCarryover Decimal             @default(0) @db.Decimal(14, 2)
  protectedBuffer   Decimal             @default(0) @db.Decimal(14, 2)
  status            PaydayCheckinStatus @default(DRAFT)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  snapshots   PaydayAccountSnapshot[]
  allocations PaydayPlanAllocation[]

  @@unique([year, month, period])
  @@index([status])
}

/// A reported-balance-vs-ledger reconciliation snapshot for one account in one
/// check-in. Never mutates Account/Transaction data - see getAccountBalances
/// in src/lib/data/accounts.ts for how expectedLedgerBalance is computed.
model PaydayAccountSnapshot {
  id                    String   @id @default(cuid())
  paydayCheckinId       String
  accountId             String
  expectedLedgerBalance Decimal  @db.Decimal(14, 2)
  reportedBalance       Decimal  @db.Decimal(14, 2)
  difference            Decimal  @db.Decimal(14, 2)
  incomeEntered         Decimal  @default(0) @db.Decimal(14, 2)
  /// The part of incomeEntered the user said is one-off (a bonus, a 13th
  /// salary), in the same currency. Still the period's income; left out of
  /// the income estimate (periodIncome's "estimate" basis in
  /// src/lib/data/period-income.ts), like a one-off income row. Null on
  /// snapshots written before it existed, read as 0.
  oneOffIncome          Decimal? @db.Decimal(14, 2)
  /// The part of incomeEntered that deposits already in the ledger held when
  /// the check-in was confirmed (ordinary INCOME rows on the account in the
  /// period's income window, see loadLedgerDeposits in src/lib/data/period-income.ts), in the same
  /// currency. The check-in adopts them as they are - never edits or deletes
  /// them - and its own INCOME row (incomeTransactionId) holds only the rest,
  /// incomeEntered - adoptedIncome. Period income counts the deposits as rows
  /// and the snapshot for that rest, so the money is counted once. Null on
  /// snapshots written before it existed, read as 0.
  adoptedIncome         Decimal? @db.Decimal(14, 2)
  /// The deposits adoptedIncome is made of: the Transaction ids Step 2 listed
  /// and confirm adopted. The confirmed plan's income follows them as they
  /// are now - each one's pay part (amount less what an earmark still
  /// covers), 0 once it is deleted, marked one-off or moved out of the
  /// period - plus the check-in's own row (paycheckNow in
  /// src/lib/period-income.ts). Null (read as empty) on snapshots written
  /// before it existed: those keep incomeEntered as confirmed.
  adoptedTransactionIds String[]
  incomeNote            String?
  /// The actual INCOME Transaction created for the part of incomeEntered the
  /// ledger did not already hold (incomeEntered - adoptedIncome > 0), if any -
  /// so re-confirming updates/removes that one row instead of creating another.
  incomeTransactionId   String?  @unique
  currency              String
  createdAt             DateTime @default(now())

  checkin PaydayCheckin @relation(fields: [paydayCheckinId], references: [id], onDelete: Cascade)
  account Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([paydayCheckinId, accountId])
}

/// Why/how each dollar in a confirmed plan was reserved or suggested - an audit
/// trail alongside the real Budget rows the plan writes. Never itself an actual
/// expense, GoalContribution, or transaction.
model PaydayPlanAllocation {
  id                String               @id @default(cuid())
  paydayCheckinId   String
  type              PaydayAllocationType
  categoryId        String?
  goalId            String?
  recurringItemId   String?
  /// Which account this line is funded from - set on the per-account BUFFER
  /// rows and stamped onto each SUBSCRIPTION row from its recurring item at
  /// confirm time. Null for lines that aren't tied to one account.
  accountId         String?
  recommendedAmount Decimal              @db.Decimal(14, 2)
  plannedAmount     Decimal              @db.Decimal(14, 2)
  currency          String
  basis             String?
  note              String?
  createdAt         DateTime             @default(now())

  checkin       PaydayCheckin  @relation(fields: [paydayCheckinId], references: [id], onDelete: Cascade)
  category      Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  goal          Goal?          @relation(fields: [goalId], references: [id], onDelete: SetNull)
  recurringItem RecurringItem? @relation(fields: [recurringItemId], references: [id], onDelete: SetNull)
  account       Account?       @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([paydayCheckinId, type])
  @@index([accountId])
}
