// Cadence - personal finance schema.
// Money is Decimal(14,2); dates that represent a calendar day are @db.Date.
// Phase 2A: EmailConnection stores OAuth-connected Gmail/Outlook accounts, and
// StagedTransaction is now written to by the email ingestion pipeline.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Currencies are plain strings (ISO 4217) rather than an enum so a new one is a
/// one-line change in src/lib/currency.ts instead of a migration.

enum AccountType {
  CHECKING
  SAVINGS
  CASH
  OTHER
}

enum AccountStatus {
  ACTIVE
  ARCHIVED
}

enum CategoryKind {
  EXPENSE
  INCOME
}

enum TransactionType {
  EXPENSE
  INCOME
  TRANSFER
  OPENING_BALANCE
  EXTERNAL_TRANSFER
}

enum TransactionSource {
  MANUAL
  CSV
  GMAIL
  OUTLOOK
  PAYPAL
  PAYDAY_CHECKIN
  OPENING_BALANCE
  /// Posted automatically from a RecurringItem on its due date - see
  /// postDueRecurringItems() in src/lib/recurring-posting.ts.
  RECURRING
}

/// Which leg of a transfer a row is (OUT on the source leg, IN on the
/// destination leg), or, for an EXTERNAL_TRANSFER row (no paired leg), simply
/// whether money left (OUT) or arrived (IN). Null for every other type.
enum TransferDirection {
  OUT
  IN
}

enum StagedStatus {
  PENDING
  APPROVED
  REJECTED
}

enum EmailProvider {
  GMAIL
  OUTLOOK
}

enum PayPeriod {
  A
  B
}

enum RecurringFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
  YEARLY
}

enum RecurringKind {
  SUBSCRIPTION
  CONTRIBUTION
}

/// Singleton row: the PIN gate and app-wide preferences.
model Settings {
  id                         String    @id @default("singleton")
  pinHash                    String?
  displayCurrency            String    @default("USD")
  language                   String    @default("en")
  /// Payday planner: default protected buffer = max(bufferPercent% of income, bufferFloorAmount).
  bufferPercent              Int       @default(10)
  bufferFloorAmount          Decimal   @default(2000) @db.Decimal(14, 2)
  bufferFloorCurrency        String    @default("DOP")
  carryoverIncludedByDefault Boolean   @default(true)
  /// The civil date (APP_TIMEZONE) the user last dismissed the auto-opened
  /// payday check-in prompt, so it doesn't force-open again the same day.
  checkinPromptDismissedOn   DateTime? @db.Date
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt
}

model Account {
  id                 String                  @id @default(cuid())
  name               String
  currency           String
  type               AccountType             @default(CHECKING)
  status             AccountStatus           @default(ACTIVE)
  archivedAt         DateTime?
  createdAt          DateTime                @default(now())
  transactions       Transaction[]
  stagedTransactions StagedTransaction[]
  paydaySnapshots    PaydayAccountSnapshot[]
  paydayAllocations  PaydayPlanAllocation[]
  recurringItems     RecurringItem[]

  @@index([name])
  @@index([status, name])
}

model Category {
  id                    String                 @id @default(cuid())
  name                  String                 @unique
  kind                  CategoryKind           @default(EXPENSE)
  isSubscriptionDefault Boolean                @default(false)
  /// Marks the category whose expense transactions count as savings/investing
  /// rather than lifestyle spending in the monthly pace feature (src/lib/data/monthly.ts).
  isSavingsDefault      Boolean                @default(false)
  /// User-configured: this category is essential fixed spending, so the payday
  /// planner reserves it before flexible category suggestions instead of
  /// treating it as discretionary. Never inferred from the category's name.
  isEssentialFixed      Boolean                @default(false)
  color                 String                 @default("#7a8590")
  icon                  String?
  createdAt             DateTime               @default(now())
  transactions          Transaction[]
  budgets               Budget[]
  recurringItems        RecurringItem[]
  stagedTransactions    StagedTransaction[]
  paydayAllocations     PaydayPlanAllocation[]

  @@index([kind])
}

model Transaction {
  id                String             @id @default(cuid())
  date              DateTime           @db.Date
  amount            Decimal            @db.Decimal(14, 2)
  currency          String
  type              TransactionType
  accountId         String
  categoryId        String?
  note              String?
  source            TransactionSource  @default(MANUAL)
  /// Identifier from the originating system (Phase 2 dedup). Null for manual/csv.
  externalId        String?
  /// Both legs of a transfer share this id.
  transferId        String?
  /// OUT on the source leg, IN on the destination leg, null otherwise.
  transferDirection TransferDirection?
  createdAt         DateTime           @default(now())

  account  Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@unique([source, externalId])
  @@index([date])
  @@index([accountId, date])
  @@index([categoryId])
  @@index([transferId])
  @@index([type, date])
}

/// Written by the Phase 2A email ingestion pipeline; reviewed on /review before
/// becoming a real Transaction.
model StagedTransaction {
  id                  String            @id @default(cuid())
  date                DateTime          @db.Date
  amount              Decimal           @db.Decimal(14, 2)
  currency            String
  rawDescription      String
  suggestedCategoryId String?
  /// The account the item will land in on approval. Nullable because
  /// ingestion cannot know which of the user's accounts an email belongs to -
  /// the reviewer picks it before approving.
  accountId           String?
  source              TransactionSource
  externalId          String?
  status              StagedStatus      @default(PENDING)
  createdAt           DateTime          @default(now())
  /// When the ingestion pipeline parsed and wrote this row (debugging/audit).
  parsedAt            DateTime?
  reviewedAt          DateTime?

  suggestedCategory Category? @relation(fields: [suggestedCategoryId], references: [id], onDelete: SetNull)
  account           Account?  @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@unique([source, externalId])
  @@index([status, date])
}

/// One row per OAuth-connected mailbox (Gmail or Outlook). Single-user app, so
/// no owner reference is needed - this is the full set of connected inboxes.
model EmailConnection {
  id                   String        @id @default(cuid())
  provider             EmailProvider
  emailAddress         String
  /// AES-256-GCM ciphertext (iv + authTag + data, base64), never the raw token.
  accessTokenEnc       String
  refreshTokenEnc      String
  accessTokenExpiresAt DateTime
  lastSyncedAt         DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@unique([provider, emailAddress])
}

/// One row per (year, month, period, category). categoryId null = the overall
/// budget for that period; a partial unique index in the migration keeps that
/// row unique, which a plain composite unique cannot do (NULLs are distinct).
model Budget {
  id         String    @id @default(cuid())
  year       Int
  month      Int
  period     PayPeriod
  categoryId String?
  amount     Decimal   @db.Decimal(14, 2)
  currency   String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  category Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([year, month, period, categoryId])
  @@index([year, month, period])
}

/// Automatic posting (src/lib/recurring-posting.ts) charges each due
/// occurrence as a RECURRING-source EXPENSE from `accountId`; a CONTRIBUTION
/// additionally logs a GoalContribution on `goalId`. Both links are nullable so
/// pre-existing rows survive, but an item missing the link its kind needs is
/// skipped (never advanced) by the posting job until the user sets it.
model RecurringItem {
  id           String             @id @default(cuid())
  name         String
  amount       Decimal            @db.Decimal(14, 2)
  currency     String
  frequency    RecurringFrequency
  kind         RecurringKind
  nextDate     DateTime           @db.Date
  /// The day of the month this item is really due on. advanceDate() clamps to
  /// this rather than to the previous occurrence's day, so a short February can
  /// never drag every later occurrence back with it. Set from the date the user
  /// picks and only ever rewritten by an explicit edit - automatic posting
  /// never touches it. Null only for rows written outside the app, where
  /// posting falls back to the occurrence's own day (the pre-anchor behaviour).
  anchorDay    Int?
  active       Boolean            @default(true)
  categoryId   String?
  /// The account each posted occurrence is charged to. Required for posting.
  accountId    String?
  /// CONTRIBUTION only: the goal each posted occurrence is logged against.
  /// Ignored for SUBSCRIPTION items.
  goalId       String?
  note         String?
  /// Set by Phase 2 auto-detection; unused for now.
  detectedFrom TransactionSource?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  category          Category?              @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  account           Account?               @relation(fields: [accountId], references: [id], onDelete: SetNull)
  goal              Goal?                  @relation(fields: [goalId], references: [id], onDelete: SetNull)
  paydayAllocations PaydayPlanAllocation[]
  goalContributions GoalContribution[]

  @@index([active, nextDate])
  @@index([kind])
  @@index([accountId])
  @@index([goalId])
}

model Goal {
  id           String    @id @default(cuid())
  name         String
  targetAmount Decimal   @db.Decimal(14, 2)
  currency     String
  targetDate   DateTime? @db.Date
  /// Cached sum of contributions. GoalContribution is the source of truth;
  /// see recomputeGoalSaved() in src/lib/goals.ts.
  savedAmount  Decimal   @default(0) @db.Decimal(14, 2)
  createdAt    DateTime  @default(now())
  achievedAt   DateTime?

  contributions     GoalContribution[]
  paydayAllocations PaydayPlanAllocation[]
  recurringItems    RecurringItem[]
}

model GoalContribution {
  id              String   @id @default(cuid())
  goalId          String
  amount          Decimal  @db.Decimal(14, 2)
  currency        String
  date            DateTime @db.Date
  note            String?
  /// Set only when recurring posting created this row automatically (see
  /// src/lib/recurring-posting.ts); null for manually-logged contributions.
  /// Only good for finding the item that is still there - the FK nulls this on
  /// delete, so classification must not depend on it (see recurringExternalId).
  recurringItemId String?
  /// The externalId of the Transaction this row was posted alongside, i.e.
  /// "<recurringItemId>:<YYYY-MM-DD>". A plain string with no foreign key, so
  /// deleting the RecurringItem cannot erase it the way it erases
  /// recurringItemId. This is what pairs an auto-posted contribution with its
  /// Transaction in the monthly savings/investing calculation, so the pair is
  /// counted once whether or not the item still exists.
  recurringExternalId String?
  createdAt       DateTime @default(now())

  goal          Goal           @relation(fields: [goalId], references: [id], onDelete: Cascade)
  recurringItem RecurringItem? @relation(fields: [recurringItemId], references: [id], onDelete: SetNull)

  @@index([goalId, date])
  @@index([recurringItemId])
  @@index([recurringExternalId])
}

/// Raw USD-based rates from open.er-api.com. rate = units of targetCurrency per
/// 1 baseCurrency. Considered fresh for 24h from fetchedAt.
model ExchangeRate {
  id             String   @id @default(cuid())
  baseCurrency   String
  targetCurrency String
  rate           Decimal  @db.Decimal(20, 10)
  fetchedAt      DateTime

  @@unique([baseCurrency, targetCurrency])
}

enum PaydayCheckinStatus {
  DRAFT
  CONFIRMED
}

enum PaydayAllocationType {
  SUBSCRIPTION
  RECURRING_CONTRIBUTION
  GOAL
  ESSENTIAL_CATEGORY
  FLEXIBLE_CATEGORY
  BUFFER
  CARRYOVER
}

/// One row per pay period the user has checked in for. Confirming a check-in
/// creates its income transactions and snapshots; re-confirming an existing
/// CONFIRMED row updates it in place rather than duplicating anything - see
/// confirmPaydayCheckinAction in src/server/actions/payday.ts.
model PaydayCheckin {
  id                String              @id @default(cuid())
  year              Int
  month             Int
  period            PayPeriod
  checkinDate       DateTime            @db.Date
  currency          String
  totalIncome       Decimal             @default(0) @db.Decimal(14, 2)
  includedCarryover Decimal             @default(0) @db.Decimal(14, 2)
  protectedBuffer   Decimal             @default(0) @db.Decimal(14, 2)
  status            PaydayCheckinStatus @default(DRAFT)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  snapshots   PaydayAccountSnapshot[]
  allocations PaydayPlanAllocation[]

  @@unique([year, month, period])
  @@index([status])
}

/// A reported-balance-vs-ledger reconciliation snapshot for one account in one
/// check-in. Never mutates Account/Transaction data - see getAccountBalances
/// in src/lib/data/accounts.ts for how expectedLedgerBalance is computed.
model PaydayAccountSnapshot {
  id                    String   @id @default(cuid())
  paydayCheckinId       String
  accountId             String
  expectedLedgerBalance Decimal  @db.Decimal(14, 2)
  reportedBalance       Decimal  @db.Decimal(14, 2)
  difference            Decimal  @db.Decimal(14, 2)
  incomeEntered         Decimal  @default(0) @db.Decimal(14, 2)
  incomeNote            String?
  /// The actual INCOME Transaction created for incomeEntered > 0, if any - so
  /// re-confirming updates/removes that one row instead of creating another.
  incomeTransactionId   String?  @unique
  currency              String
  createdAt             DateTime @default(now())

  checkin PaydayCheckin @relation(fields: [paydayCheckinId], references: [id], onDelete: Cascade)
  account Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([paydayCheckinId, accountId])
}

/// Why/how each dollar in a confirmed plan was reserved or suggested - an audit
/// trail alongside the real Budget rows the plan writes. Never itself an actual
/// expense, GoalContribution, or transaction.
model PaydayPlanAllocation {
  id                String               @id @default(cuid())
  paydayCheckinId   String
  type              PaydayAllocationType
  categoryId        String?
  goalId            String?
  recurringItemId   String?
  /// Which account this line is funded from - set on the per-account BUFFER
  /// rows and stamped onto each SUBSCRIPTION row from its recurring item at
  /// confirm time. Null for lines that aren't tied to one account.
  accountId         String?
  recommendedAmount Decimal              @db.Decimal(14, 2)
  plannedAmount     Decimal              @db.Decimal(14, 2)
  currency          String
  basis             String?
  note              String?
  createdAt         DateTime             @default(now())

  checkin       PaydayCheckin  @relation(fields: [paydayCheckinId], references: [id], onDelete: Cascade)
  category      Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  goal          Goal?          @relation(fields: [goalId], references: [id], onDelete: SetNull)
  recurringItem RecurringItem? @relation(fields: [recurringItemId], references: [id], onDelete: SetNull)
  account       Account?       @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([paydayCheckinId, type])
  @@index([accountId])
}
