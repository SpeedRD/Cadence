# Server-only. Never prefix these with NEXT_PUBLIC_ - that would ship them to
# the browser. NEXT_PUBLIC_ is reserved for values you intentionally want
# public client-side, which none of these are.

# Runtime DB connection, read by the Next.js app (src/lib/prisma.ts) in both
# local dev and on Vercel. Local Postgres: postgresql://user:password@127.0.0.1:5432/dbname
# Supabase (production): the transaction-mode pooler, port 6543, with
# ?pgbouncer=true - from Project Settings -> Database -> Connection string ->
# "Transaction pooler".
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"

# Prisma CLI only (prisma7.config.ts): migrate/seed/studio need a
# session-capable connection, which the transaction pooler above doesn't
# support for DDL. Not required for local dev against a single Postgres
# instance (prisma7.config.ts falls back to DATABASE_URL when this is unset).
# Supabase: the session-mode pooler, port 5432, from the same "Connection
# string" panel -> "Session pooler".
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# Signs the session cookie. Any long random string: `openssl rand -hex 32`.
SESSION_SECRET="replace-with-a-long-random-string"

# IANA timezone used to decide what "today" is when resolving pay periods.
# Defaults to America/Santo_Domingo.
APP_TIMEZONE="America/Santo_Domingo"

# --- Phase 2A: email ingestion (see PHASE2.md for full setup steps) ---

# Canonical production origin (no trailing slash), e.g. https://cadence.vercel.app
# or a custom domain. Required in production so the Gmail OAuth redirect_uri
# is a stable value that matches an Authorized redirect URI in Google Cloud
# Console, instead of the request's (deployment-specific) hostname. Not
# needed locally - local dev falls back to the request's own origin
# (http://localhost:3000).
APP_URL=""

# Encrypts stored OAuth tokens at rest (AES-256-GCM). Any string works (it's
# hashed to 32 bytes): `openssl rand -hex 32`.
OAUTH_ENCRYPTION_KEY="replace-with-a-long-random-string"

# Bearer token required by /api/cron/ingest. Vercel Cron sends this
# automatically once set in the project's environment variables.
CRON_SECRET="replace-with-a-long-random-string"

# Google Cloud Console -> APIs & Services -> Credentials (OAuth client ID).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Azure portal -> Microsoft Entra ID -> App registrations.
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
# Optional - defaults to "common" (personal + work/school accounts).
MICROSOFT_TENANT_ID=""

# console.anthropic.com - used to parse emails into structured transactions.
ANTHROPIC_API_KEY=""
